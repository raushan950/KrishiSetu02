{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend/",
      "framework": "vite",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    },
    "backend": {
      "root": "backend/",
      "framework": "django",
      "entrypoint": "config.wsgi:application",
      "functions": {
        "**/*.py": {
          "maxDuration": 60,
          "excludeFiles": "{tests/**,**/tests/**,e2e_full_verification.py,fetch_video.py,build.sh,Dockerfile}"
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/health",
      "destination": { "service": "backend", "path": "/health/" }
    },
    {
      "source": "/health/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/admin",
      "destination": { "service": "backend", "path": "/admin/" }
    },
    {
      "source": "/admin/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/static/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "frontend" }
    }
  ]
}
