# Development only. Replace with a strong unique key for every deployment.
DJANGO_DEBUG=1
POSTGRES_PASSWORD=REPLACE_WITH_UNIQUE_LOCAL_PASSWORD
DJANGO_SECRET_KEY=change-this-to-a-random-secret-before-any-public-deployment
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DATABASE_URL=postgresql://krishi:change_me@db:5432/krishisetu
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
SUPABASE_ACCESS_TOKEN=your-supabase-access-token
# Leave blank to disable Google account login.
GOOGLE_CLIENT_ID=
# Email: use smtp.EmailBackend for actual email delivery; console backend is DEV ONLY.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=no-reply@example.org
# Provider options: fast2sms, twilio, or blank to report unavailable.
SMS_PROVIDER=
FAST2SMS_API_KEY=
FAST2SMS_OTP_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Optional official-data API integration. Configure correct OGD resource permitted by provider.
OGD_API_KEY=
OGD_RESOURCE_ID=
# Recommended multi-instance Redis cache for throttling and verification cooldowns.
REDIS_URL=redis://redis:6379/0
# Development reverse proxy only; production requires separate TLS ingress.
SECURE_SSL_REDIRECT=0
VITE_API_BASE_URL=/api/v1/

# Razorpay requires an authorized merchant account. Test keys may be used in an isolated test-mode environment.
# No live payments are possible without all three values AND provider webhook setup.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional road-route provider and grounded LLM narration. Real accounts must be verified.
ORS_API_KEY=
MARKET_LLM_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Mandi import (bounded pagination; provider quota/terms apply)
OGD_IMPORT_PAGE_SIZE=500
OGD_IMPORT_MAX_PAGES=100

# -----------------------------------------------------------------------------
# SUPABASE PLATFORM INTEGRATION
# -----------------------------------------------------------------------------
# Supabase Project URL (Project Settings > API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Public / Anon Key (Publishable client key)
SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Backend-Only Service-Role Credential (NEVER expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Supabase JWT Secret for cryptographic signature verification (HS256)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Frontend Supabase Client Environment Variables
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
